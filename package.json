{
  "name": "scholar-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two-pane academic PDF reader for Firefox/Zen: paper left, AI section outline right.",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "check:secrets": "node tools/check-secrets.mjs",
    "test": "node tools/test/adapter.test.mjs && node tools/test/router.test.mjs",
    "probe": "node tools/live-probe.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
